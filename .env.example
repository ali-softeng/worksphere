# Local PostgreSQL credentials
DEV_DB_USERNAME=your-local-db-username
DEV_DB_PASSWORD=your-local-db-password

# Docker PostgreSQL credentials
DB_USERNAME=your-docker-db-username
DB_PASSWORD=your-docker-db-password

# Secret used to sign JWTs
JWT_SECRET=your-jwt-secret

# SMTP email credentials
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password